  ;; Replace first occurrence of old with new
  (func $str_replace (param $str i32) (param $old i32) (param $new i32) (result i32)
    (local $idx i32)
    (local $strLen i32)
    (local $oldLen i32)
    (local $newLen i32)
    (local $resultLen i32)
    (local $newPtr i32)
    (local $i i32)
    (local $srcIdx i32)
