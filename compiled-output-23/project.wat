          (then (i32.sub (local.get $c) (i32.const 55)))
          (else
            (if (result i32) (i32.and (i32.ge_u (local.get $c) (i32.const 97)) (i32.le_u (local.get $c) (i32.const 102)))
              (then (i32.sub (local.get $c) (i32.const 87)))
              (else (i32.const 0))))))))
  
