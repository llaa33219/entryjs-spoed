  ;; Thread 47: when_run_button_click for entity 8
  (func $thread_47_run (param $entityIdx i32) (result i32)
    (local $pc i32)
    (local $temp f64)
    (local $temp2 f64)
    (local $iterCount i32)
    (local $condResult i32)
    (local $temp_str_ptr i32)
    
    ;; Get current program counter
    (local.set $pc (global.get $thread_47_pc))
    
    ;; Check if waiting
    (if (f64.gt (global.get $thread_47_waiting) (f64.const 0))
      (then
        (global.set $thread_47_waiting
          (f64.sub (global.get $thread_47_waiting) (global.get $deltaTime)))
        (return (i32.const 1))))  ;; Still running
    
    ;; Execute based on PC
    (block $end
      (block $done
        (block $pc_0
          (br_if $pc_0 (i32.ne (local.get $pc) (i32.const 0)))
          ;; set_variable: TTdisable
          (call $setVariable (i32.const 2744) (f64.const 10))
          (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
          (global.set $thread_47_pc (local.get $pc))
          (global.set $thread_47_resumeDepth (i32.const 0))
          (global.set $thread_47_waitPhase (i32.const 0))
          (br $done))
        (block $pc_1
          (br_if $pc_1 (i32.ne (local.get $pc) (i32.const 1)))
          ;; repeat_basic (EntryJS-compatible: one iteration per tick, depth 0, has nested loop)
          ;; Only init counter when NOT resuming from deeper loop
          (if (i32.eqz (i32.gt_s (global.get $thread_47_resumeDepth) (i32.const 1)))
            (then
              (if (i32.eq (global.get $thread_47_loopCounter_0) (i32.const -1))
                (then
                  (global.set $thread_47_loopCounter_0 (i32.trunc_f64_s (f64.const 50)))))))
          ;; Check if iterations remain (counter > 0) OR resuming from deeper loop
          (if (i32.or (i32.gt_s (global.get $thread_47_resumeDepth) (i32.const 1)) (i32.gt_s (global.get $thread_47_loopCounter_0) (i32.const 0)))
            (then
              ;; Only decrement and execute preamble when NOT resuming from deeper
              (if (i32.eqz (i32.gt_s (global.get $thread_47_resumeDepth) (i32.const 1)))
                (then
                  (global.set $thread_47_loopCounter_0
                    (i32.sub (global.get $thread_47_loopCounter_0) (i32.const 1)))
                  ))
              ;; Always execute from nested loop onwards
              
          ;; repeat_basic (EntryJS-compatible: one iteration per tick, depth 1)
          ;; Initialize loop counter on first entry (when counter is -1)
          (if (i32.eq (global.get $thread_47_loopCounter_1) (i32.const -1))
            (then
              (global.set $thread_47_loopCounter_1 (i32.trunc_f64_s (f64.const 218)))))
          ;; Check if iterations remain (counter > 0)
          (if (i32.gt_s (global.get $thread_47_loopCounter_1) (i32.const 0))
            (then
              ;; Decrement counter first (like EntryJS)
              (global.set $thread_47_loopCounter_1
                (i32.sub (global.get $thread_47_loopCounter_1) (i32.const 1)))
              ;; Execute inner blocks
              
          ;; add_value_to_list: 수의스콩터
          (call $list_push (i32.const 13) (f64.const 0))
          ;; add_value_to_list: 수배열
          (call $list_push (i32.const 31) (f64.const 0))
          ;; TODO: Unsupported block type: Talebot_Move
          (nop)
              ;; Add tiny delay and stay at same PC for next iteration
              (global.set $thread_47_resumeDepth (i32.const 2))
              (global.set $thread_47_waiting (f64.const 0.001))
              (return (i32.const 1))))
          ;; Loop finished - reset counter for potential re-entry
          (global.set $thread_47_loopCounter_1 (i32.const -1))
          ;; add_value_to_list: BestMove
          (call $list_push (i32.const 5) (f64.const 0))
          ;; add_value_to_list: Firstmove
          (call $list_push (i32.const 6) (f64.const 0))
          ;; add_value_to_list: LASTSPECIA
          (call $list_push (i32.const 2) (f64.const 0))
          ;; add_value_to_list: LASTFROM
          (call $list_push (i32.const 3) (f64.const 0))
          ;; add_value_to_list: LASTTO
          (call $list_push (i32.const 4) (f64.const 0))
          ;; add_value_to_list: TTmove
          (call $list_push (i32.const 7) (f64.const 0))
          ;; add_value_to_list: BestScore
          (call $list_push (i32.const 14) (f64.const 0))
          ;; add_value_to_list: B
          (call $list_push (i32.const 15) (f64.const 0))
          ;; add_value_to_list: A
          (call $list_push (i32.const 16) (f64.const 0))
          ;; add_value_to_list: 이발디바이더저장
          (call $list_push (i32.const 17) (f64.const 0))
          ;; add_value_to_list: 미들게임이발저장
          (call $list_push (i32.const 18) (f64.const 0))
          ;; add_value_to_list: 엔드게임이발저장
          (call $list_push (i32.const 19) (f64.const 0))
          ;; add_value_to_list: 수길이
          (call $list_push (i32.const 20) (f64.const 0))
          ;; add_value_to_list: 인덱스
          (call $list_push (i32.const 21) (f64.const 0))
          ;; add_value_to_list: 잡은기물
          (call $list_push (i32.const 22) (f64.const 0))
          ;; add_value_to_list: PHalfClock
          (call $list_push (i32.const 26) (f64.const 0))
          ;; add_value_to_list: Phash
          (call $list_push (i32.const 24) (f64.const 0))
          ;; add_value_to_list: PeP
          (call $list_push (i32.const 25) (f64.const 0))
          ;; add_value_to_list: PCast[ply]
          (call $list_push (i32.const 27) (f64.const 0))
          ;; TODO: Unsupported block type: Talebot_Move
          (nop)
              (global.set $thread_47_waitPhase (i32.const 0))
              ;; Yield (reached when nested loop finished and fell through)
              (global.set $thread_47_resumeDepth (i32.const 1))
              (global.set $thread_47_waiting (f64.const 0.001))
              (return (i32.const 1))))
          ;; Loop finished - reset counter for potential re-entry
          (global.set $thread_47_loopCounter_0 (i32.const -1))
          (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
          (global.set $thread_47_pc (local.get $pc))
          (global.set $thread_47_resumeDepth (i32.const 0))
          (global.set $thread_47_waitPhase (i32.const 0))
          (br $done))
        (block $pc_2
          (br_if $pc_2 (i32.ne (local.get $pc) (i32.const 2)))
          ;; start_scene (changes to scene 1)
          (call $startScene (i32.const 1))
          ;; Terminate this thread after scene change
          (global.set $thread_47_pc (i32.const 0))
          (global.set $thread_47_active (i32.const 0))
          (return (i32.const 0))
          (local.set $pc (i32.add (local.get $pc) (i32.const 1)))
