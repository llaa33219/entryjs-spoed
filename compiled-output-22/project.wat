  ;; ===== CLONE FUNCTIONS =====
  (func $createClone (param $entityIdx i32)
    (if (i32.eq (local.get $entityIdx) (i32.const 0))
      (then (global.set $clone_requested_0 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 1))
      (then (global.set $clone_requested_1 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 2))
      (then (global.set $clone_requested_2 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 3))
      (then (global.set $clone_requested_3 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 4))
      (then (global.set $clone_requested_4 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 5))
      (then (global.set $clone_requested_5 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 6))
      (then (global.set $clone_requested_6 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 7))
      (then (global.set $clone_requested_7 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 8))
      (then (global.set $clone_requested_8 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 9))
      (then (global.set $clone_requested_9 (i32.const 1))))
    (if (i32.eq (local.get $entityIdx) (i32.const 10))
      (then (global.set $clone_requested_10 (i32.const 1))))
    (call $createCloneVisual (local.get $entityIdx)))


  ;; ===== USER FUNCTIONS =====
  
