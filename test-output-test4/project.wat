  (func $thread_0_run (param $entityIdx i32) (result i32)
    (local $pc i32)
    (local $temp f64)
    (local $iterCount i32)
    (local $condResult i32)
    (local $temp_str_ptr i32)
    
    ;; Get current program counter
    (local.set $pc (global.get $thread_0_pc))
    
    ;; Check if waiting
    (if (f64.gt (global.get $thread_0_waiting) (f64.const 0))
      (then
        (global.set $thread_0_waiting
          (f64.sub (global.get $thread_0_waiting) (global.get $deltaTime)))
        (return (i32.const 1))))  ;; Still running
    
    ;; Execute based on PC
    (block $end
      (block $done
        ;; End of thread
        (global.set $thread_0_pc (i32.const 0))
        (return (i32.const 0))  ;; Thread finished
      )  ;; $done
    )  ;; $end
    
    (i32.const 1)  ;; Thread still running
  )
  
  ;; Thread 1: comment for entity 0
  (func $thread_1_run (param $entityIdx i32) (result i32)
    (local $pc i32)
    (local $temp f64)
    (local $iterCount i32)
    (local $condResult i32)
    (local $temp_str_ptr i32)
    
    ;; Get current program counter
    (local.set $pc (global.get $thread_1_pc))
    
    ;; Check if waiting
    (if (f64.gt (global.get $thread_1_waiting) (f64.const 0))
      (then
        (global.set $thread_1_waiting
          (f64.sub (global.get $thread_1_waiting) (global.get $deltaTime)))
        (return (i32.const 1))))  ;; Still running
    
    ;; Execute based on PC
    (block $end
      (block $done
        ;; End of thread
        (global.set $thread_1_pc (i32.const 0))
        (return (i32.const 0))  ;; Thread finished
      )  ;; $done
    )  ;; $end
    
    (i32.const 1)  ;; Thread still running
  )
  
