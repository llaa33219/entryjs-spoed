  (func $getListVisible_4 (result i32) (global.get $list_visible_4))
  (func $setListVisible_4 (param $v i32) (global.set $list_visible_4 (local.get $v)))
  (func $getListVisible_5 (result i32) (global.get $list_visible_5))
  (func $setListVisible_5 (param $v i32) (global.set $list_visible_5 (local.get $v)))
  (func $getListVisible_6 (result i32) (global.get $list_visible_6))
  (func $setListVisible_6 (param $v i32) (global.set $list_visible_6 (local.get $v)))
