  (func $getVarVisible_83 (result i32) (global.get $var_visible_83))
  (func $setVarVisible_83 (param $v i32) (global.set $var_visible_83 (local.get $v)))
  (func $getVarVisible_84 (result i32) (global.get $var_visible_84))
  (func $setVarVisible_84 (param $v i32) (global.set $var_visible_84 (local.get $v)))
  (func $getListVisible_0 (result i32) (global.get $list_visible_0))
  (func $setListVisible_0 (param $v i32) (global.set $list_visible_0 (local.get $v)))
  (func $getListVisible_1 (result i32) (global.get $list_visible_1))
  (func $setListVisible_1 (param $v i32) (global.set $list_visible_1 (local.get $v)))
  (func $getListVisible_2 (result i32) (global.get $list_visible_2))
